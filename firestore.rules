rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['admin@thegreenshadow.com', 'mdmahedi069mm@gmail.com'] ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Orders Collection ---
    // Customers can create orders and read their specific order by document ID.
    // Admin staff can list and update orders (e.g. status, driver assignment).
    match /orders/{orderId} {
      allow create: if isValidId(orderId)
        && request.resource.data.id == orderId
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;

      // Customer can read single order document by ID, or admin can read/list
      allow get: if true;
      allow list: if isAdmin();

      // Updates: Admin can update any field (status, timeline, driver);
      // Customer can only submit rating/review
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewText', 'updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
      );

      allow delete: if isAdmin();
    }

    // --- Reservations Collection ---
    match /reservations/{reservationId} {
      allow create: if isValidId(reservationId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.guests is number
        && request.resource.data.guests > 0;

      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Event Inquiries Collection ---
    match /eventInquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && request.resource.data.name is string
        && request.resource.data.phone is string;

      allow get, list, update, delete: if isAdmin();
    }

    // --- Menu Items / Inventory Collection ---
    match /menuItems/{itemId} {
      // Menu items are publicly readable by any visitor
      allow read: if true;
      // Only authenticated admin staff can toggle availability or edit items
      allow write: if isAdmin();
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Provisioned securely via Firebase Console / Admin SDK
    }
  }
}
